# DoomTrade Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000

# Trading mode: "sim" (paper trading, no real orders) or "live" (real orders)
TRADE_MODE=sim

# Alpaca (stocks) — get keys at https://app.alpaca.markets/
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true

# CCXT (crypto) — exchange to use for crypto trading
CCXT_EXCHANGE=binance
CCXT_API_KEY=
CCXT_API_SECRET=

# Database
DATABASE_PATH=./data/doomtrade.db

# Risk limits (defaults shown)
MAX_OPEN_POSITIONS=10
MAX_POSITION_SIZE_PCT=20
DAILY_TRADE_LIMIT=20
MAX_DRAWDOWN_PCT=15

# Sim settings
SIM_STARTING_BALANCE=100000
SIM_FEE_PCT=0.1