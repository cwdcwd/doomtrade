# DoomTrade Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000

# Trading mode: "sim" (paper trading, no real orders) or "live" (real orders)
TRADE_MODE=sim

# Alpaca (stocks) — get keys at https://app.alpaca.markets/
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true

# CCXT (crypto) — exchange to use for crypto trading
CCXT_EXCHANGE=binance
CCXT_API_KEY=
CCXT_API_SECRET=

# Database
# SQLite path (used when DATABASE_URL is not set — local dev mode)
DATABASE_PATH=./data/doomtrade.db
# Postgres connection string (set this for production — overrides SQLite)
# Example: postgresql://user:password@localhost:5432/doomtrade
DATABASE_URL=

# Risk limits (defaults shown)
MAX_OPEN_POSITIONS=10
MAX_POSITION_SIZE_PCT=20
DAILY_TRADE_LIMIT=20
MAX_DRAWDOWN_PCT=15

# Sim settings
SIM_STARTING_BALANCE=100000
SIM_FEE_PCT=0.1

# API security — set this to protect mutation endpoints (POST/PATCH/DELETE) on public deployments
# Reads (GET) are always public — the dashboard is a read-only viewer for humans.
# If empty, all auth is disabled (local dev only). Set a strong random string for production.
DOOMTRADE_API_KEY=