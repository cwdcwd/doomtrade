{
  "name": "doomtrade",
  "version": "0.1.0",
  "description": "Agent-managed stock and crypto trading platform",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@alpacahq/alpaca-trade-api": "^4.0.1",
    "@cwdcwd/agent-bridge": "git+https://github.com/cwdcwd/agent-bridge.git",
    "ccxt": "^4.5.0",
    "express": "^4.21.0",
    "pg": "^8.23.0",
    "sql.js": "^1.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/sql.js": "^1.4.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "ccxt": true,
    "esbuild": true,
    "bufferutil": true,
    "@cwdcwd/agent-bridge": true
  }
}
